# Choose sqlite, postgres, or mariadb. Each installation uses one engine.
DB_DRIVER=sqlite
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
SQLITE_PATH=data/portal.sqlite
UPLOAD_DIR=data/uploads
DB_HOST=127.0.0.1
DB_NAME=mangotek
DB_USER=mangotek
DB_PASSWORD=
# Match the selected engine: postgres, mariadb, or empty for SQLite.
COMPOSE_PROFILES=
# DATABASE_URL optionally overrides the individual server connection settings.
# Number of trusted reverse proxies; 0 means a direct connection.
TRUST_PROXY_HOPS=0
